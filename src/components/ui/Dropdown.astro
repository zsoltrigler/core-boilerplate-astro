---
export interface Props {
  /** Alignment of the menu panel relative to the trigger. */
  align?: "left" | "right"
  /**
   * Close the panel when anything inside it is clicked. Set to `false` for a
   * panel of form controls (e.g. a group of Checkboxes) that should stay open
   * between clicks — the panel then uses `role="dialog"` instead of `role="menu"`.
   */
  closeOnSelect?: boolean
  /** Accessible name for the panel — used when `closeOnSelect` is `false` (`role="dialog"` needs one). */
  label?: string
  class?: string
}

const { align = "left", closeOnSelect = true, label, class: className = "" } = Astro.props

const menuAlign = align === "right" ? "right-0" : "left-0"
---

{
  /*
   * Usage:
   *   <Dropdown>
   *     <button slot="trigger">Open</button>
   *     <a href="#" data-dropdown-item>Item</a>
   *   </Dropdown>
   *
   * The trigger receives aria-haspopup + aria-expanded automatically via the script.
   * Close on: trigger click, Escape, click outside, item selection.
   *
   * closeOnSelect={false} keeps the panel open on clicks inside it — for form-control
   * groups (e.g. filter Checkboxes). ! The panel then isn't a menu, so it gets
   * role="dialog" (+ aria-label from `label`) and the trigger announces aria-haspopup="dialog".
   */
}
<div
  data-dropdown
  data-dropdown-close-on-select={closeOnSelect ? undefined : "false"}
  class={`relative inline-flex ${className}`}
>
  <div data-dropdown-trigger>
    <slot name="trigger" />
  </div>

  <div
    data-dropdown-menu
    hidden
    role={closeOnSelect ? "menu" : "dialog"}
    aria-label={closeOnSelect ? undefined : label}
    class={`absolute top-full ${menuAlign} z-50 mt-1 min-w-44 rounded-xl border border-(--color-border-base) bg-(--color-bg-base) p-1 shadow-lg`}
  >
    <slot />
  </div>
</div>

<script>
  function initDropdowns() {
    document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dropdown) => {
      const triggerWrapper = dropdown.querySelector<HTMLElement>("[data-dropdown-trigger]")
      const menu = dropdown.querySelector<HTMLElement>("[data-dropdown-menu]")
      // * Find the first focusable element inside the trigger slot as the real button.
      const trigger = triggerWrapper?.querySelector<HTMLElement>("button, a, [role='button']")
      if (!trigger || !menu) return

      // * Wire ARIA attributes so the trigger announces its state to screen readers.
      const closeOnSelect = dropdown.dataset.dropdownCloseOnSelect !== "false"
      trigger.setAttribute("aria-haspopup", closeOnSelect ? "true" : "dialog")
      trigger.setAttribute("aria-expanded", "false")

      function open() {
        menu!.hidden = false
        trigger!.setAttribute("aria-expanded", "true")
      }

      function close() {
        menu!.hidden = true
        trigger!.setAttribute("aria-expanded", "false")
      }

      function toggle() {
        if (menu!.hidden) open()
        else close()
      }

      trigger.addEventListener("click", (e) => {
        e.stopPropagation()
        // ! Safari/WebKit doesn't focus <button> on click (unlike Chrome/Firefox),
        //   so without this, Escape's keydown listener below never receives the
        //   event — its target stays <body>, which is outside `dropdown`.
        trigger!.focus()
        toggle()
      })

      // ! Listens on document, not `dropdown`: Safari/WebKit doesn't focus a Checkbox
      //   on click either, so after toggling one the keydown target is <body> and a
      //   listener scoped to `dropdown` would never see Escape.
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !menu.hidden) {
          close()
          trigger!.focus()
        }
      })

      document.addEventListener("click", (e) => {
        if (!dropdown.contains(e.target as Node)) close()
      })

      // ! Close when any item inside the menu is clicked — covers both <a> and buttons.
      //   Skipped for closeOnSelect={false} so form controls inside can be toggled repeatedly.
      if (closeOnSelect) menu.addEventListener("click", () => close())
    })
  }

  initDropdowns()
</script>
