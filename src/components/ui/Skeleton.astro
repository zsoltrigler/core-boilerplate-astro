---
import type { HTMLAttributes } from "astro/types"
// * Extra attributes (id, data-*, aria-*, hidden, etc.) are forwarded to the root <div> via ...rest.
// ! Spread before style / aria-hidden so the sizing and decorative semantics can't be overridden.
export interface Props extends HTMLAttributes<"div"> {
  /** CSS height value — e.g. "1rem", "40px", "2lh". */
  height?: string
  /** CSS width value — e.g. "100%", "12rem". */
  width?: string
  rounded?: "none" | "sm" | "md" | "lg" | "xl" | "2xl" | "full"
  class?: string
}

const {
  height = "1rem",
  width = "100%",
  rounded = "md",
  class: className = "",
  ...rest
} = Astro.props

const roundedMap: Record<string, string> = {
  none: "rounded-none",
  sm: "rounded-sm",
  md: "rounded-md",
  lg: "rounded-lg",
  xl: "rounded-xl",
  "2xl": "rounded-2xl",
  full: "rounded-full",
}
---

<div
  {...rest}
  class={`animate-pulse bg-(--color-bg-elevated) ${roundedMap[rounded]} ${className}`}
  style={`height: ${height}; width: ${width};`}
  aria-hidden="true"
>
</div>
