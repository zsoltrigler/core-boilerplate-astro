---
import type { HTMLAttributes } from "astro/types"
import { Icon } from "astro-icon/components"

// * HTMLAttributes<"div"> is used purely for its attribute set — "div" has no
//   attributes beyond the global ones (id, data-*, aria-*, title, etc.), so this
//   is equivalent to a tag-agnostic "global HTML attributes" type, letting
//   standard attributes type-check through the ...rest spread below without
//   listing each one by hand. Deliberately NOT HTMLAttributes<"a"> /
//   HTMLAttributes<"button"> — this component renders either tag, and those
//   tag-specific variants declare incompatible `href`/`type` shapes that would
//   conflict with this component's own narrower href/type/disabled below.
export interface Props extends HTMLAttributes<"div"> {
  href?: string
  type?: "button" | "submit" | "reset"
  variant?: "primary" | "secondary" | "ghost" | "danger"
  size?: "sm" | "md" | "lg"
  fullWidth?: boolean
  /** Opens the link in a new tab (target="_blank", rel="noopener noreferrer") and flags it: a screen-reader-only "(opens in a new tab)" is appended to the link name and a small external-link icon is shown — the icon is skipped when an `icon-right` slot is given, so you keep control of the visual cue. Requires `href`. */
  newTab?: boolean
  /** Screen-reader text appended to the link name when `newTab` is set — override for a non-English site. */
  newTabLabel?: string
  /**
   * @deprecated Use `newTab`. `external` only adds target="_blank" and rel="noopener noreferrer" — no
   * screen-reader hint and no icon. Kept unchanged for backwards compatibility.
   */
  external?: boolean
  disabled?: boolean
  /** Replaces icon-left with a spinner and blocks interaction — for in-flight async actions (e.g. form submits). Doesn't dim opacity like disabled, so the button still reads as "working" rather than "unavailable". */
  loading?: boolean
  class?: string
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  fullWidth = false,
  newTab = false,
  newTabLabel = "(opens in a new tab)",
  external = false,
  disabled = false,
  loading = false,
  class: className = "",
  ...rest
} = Astro.props

// * loading blocks interaction the same way disabled does, but is tracked
//   separately so only `disabled` drives the opacity dim below — a loading
//   button should still read as "in progress", not "unavailable".
const interactionDisabled = disabled || loading

const spinnerSizes: Record<string, string> = {
  sm: "14",
  md: "16",
  lg: "18",
}

const variants: Record<string, string> = {
  primary:
    "bg-(--color-brand-primary) text-(--color-text-inverted) hover:opacity-90 transition-opacity",
  secondary:
    "border border-(--color-border-base) text-(--color-text-base) hover:bg-(--color-bg-elevated) transition-colors",
  ghost:
    "text-(--color-text-muted) hover:text-(--color-text-base) hover:bg-(--color-bg-elevated) transition-colors",
  danger:
    "bg-(--color-status-error) text-(--color-text-inverted) dark:text-(--color-bg-base) hover:opacity-90 transition-opacity",
}

const sizes: Record<string, string> = {
  sm: "h-8  px-3 text-sm  gap-1.5 rounded-md",
  md: "h-10 px-5 text-base gap-2  rounded-lg",
  lg: "h-12 px-7 text-lg  gap-2.5 rounded-xl",
}

const base = [
  "inline-flex items-center justify-center font-semibold cursor-pointer",
  disabled ? "opacity-50" : "",
  interactionDisabled ? "pointer-events-none" : "",
  loading ? "cursor-wait" : "",
  "duration-200",
  fullWidth ? "w-full" : "",
  variants[variant],
  sizes[size],
  className,
].join(" ")

// * Renders as <a> when href is provided, <button> otherwise.
// ! Never pass both href and type together — type is ignored on anchor elements.
// ! <a> does not support the disabled attribute — use aria-disabled + pointer-events-none instead.
const externalProps = newTab || external ? { target: "_blank", rel: "noopener noreferrer" } : {}
const opensInNewTab = Boolean(href) && newTab
// * The auto icon yields to a caller-supplied icon-right, and to the loading spinner state.
const showNewTabIcon = opensInNewTab && !loading && !Astro.slots.has("icon-right")
const disabledLinkProps = interactionDisabled
  ? { "aria-disabled": true as const, tabindex: "-1" }
  : {}
---

{
  href ? (
    <a
      href={interactionDisabled ? undefined : href}
      class={base}
      aria-busy={loading || undefined}
      {...externalProps}
      {...disabledLinkProps}
      {...rest}
    >
      {loading ? (
        <Icon
          is:inline
          name="line-md:loading-twotone-loop"
          width={spinnerSizes[size]}
          height={spinnerSizes[size]}
          aria-hidden="true"
        />
      ) : (
        <slot name="icon-left" />
      )}
      <slot />
      {!loading && <slot name="icon-right" />}
      {showNewTabIcon && (
        <Icon
          is:inline
          name="line-md:external-link"
          width={spinnerSizes[size]}
          height={spinnerSizes[size]}
          aria-hidden="true"
        />
      )}
      {/* * Last in the link so the accessible name reads "label (opens in a new tab)". */}
      {opensInNewTab && <span class="sr-only">{newTabLabel}</span>}
    </a>
  ) : (
    <button
      type={type}
      class={base}
      disabled={interactionDisabled}
      aria-busy={loading || undefined}
      {...rest}
    >
      {loading ? (
        <Icon
          is:inline
          name="line-md:loading-twotone-loop"
          width={spinnerSizes[size]}
          height={spinnerSizes[size]}
          aria-hidden="true"
        />
      ) : (
        <slot name="icon-left" />
      )}
      <slot />
      {!loading && <slot name="icon-right" />}
    </button>
  )
}
