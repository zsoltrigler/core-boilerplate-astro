---
import { Icon } from "astro-icon/components"

export interface Props {
  title?: string
  desc?: string
  padding?: "sm" | "md" | "lg"
  rounded?: "md" | "lg" | "xl" | "2xl"
  /** Highlight the border on hover — enabled by default. */
  hover?: boolean
  shadow?: boolean
  /** "horizontal" stacks icon left, title+desc right — falls back to vertical below the sm breakpoint. Ignored when collapsible (the header is always a single row so the chevron has a fixed anchor). */
  layout?: "vertical" | "horizontal"
  /** Renders the root as a native <details>/<summary> — click-to-expand, keyboard accessible, no JS. The icon/title/desc become the always-visible summary; the default slot and trailing slot become the collapsible body. */
  collapsible?: boolean
  /** Only applies when collapsible — open by default. */
  open?: boolean
  class?: string
}

const {
  title,
  desc,
  padding = "md",
  rounded = "xl",
  hover = true,
  shadow = false,
  layout = "vertical",
  collapsible = false,
  open = false,
  class: className = "",
} = Astro.props

const hasTrailing = Astro.slots.has("trailing")

const paddings: Record<string, string> = {
  sm: "p-3",
  md: "p-5",
  lg: "p-8",
}

const roundeds: Record<string, string> = {
  md: "rounded-md",
  lg: "rounded-lg",
  xl: "rounded-xl",
  "2xl": "rounded-2xl",
}

const RootTag = collapsible ? "details" : "div"
const HeaderTag = collapsible ? "summary" : "div"
---

<RootTag
  open={collapsible ? open : undefined}
  class={[
    "flex flex-col gap-2",
    "border border-(--color-border-base) bg-(--color-bg-surface) transition-colors duration-200",
    paddings[padding],
    roundeds[rounded],
    hover ? "hover:border-(--color-border-strong)" : "",
    shadow ? "shadow-sm" : "",
    collapsible ? "group [&[open]]:border-(--color-border-strong)" : "",
    className,
  ].join(" ")}
>
  <!-- * layout="horizontal" groups icon + title/desc into a row from the sm breakpoint up, staying stacked below it. Collapsible always uses a single row so the chevron has a fixed right-hand anchor. -->
  <HeaderTag
    class={[
      collapsible
        ? "flex cursor-pointer list-none items-center gap-3 [&::-webkit-details-marker]:hidden"
        : layout === "horizontal"
          ? "flex flex-col gap-2 sm:flex-row sm:items-start sm:gap-3"
          : "contents",
    ].join(" ")}
  >
    <!-- * Named slot takes priority over the prop — use slot="icon" for custom markup. -->
    {
      Astro.slots.has("icon") && (
        <div class="self-start text-2xl" aria-hidden="true">
          <slot name="icon" />
        </div>
      )
    }

    <div class={collapsible || layout === "horizontal" ? "flex flex-col gap-2" : "contents"}>
      <!-- * Named slot takes priority over the title prop. -->
      {
        (Astro.slots.has("title") || title) && (
          <div class="self-start font-semibold text-(--color-text-base)">
            {Astro.slots.has("title") ? <slot name="title" /> : title}
          </div>
        )
      }

      <!-- * Named slot takes priority over the desc prop. -->
      {
        (Astro.slots.has("desc") || desc) && (
          <div class="self-start text-sm leading-relaxed text-(--color-text-muted)">
            {Astro.slots.has("desc") ? <slot name="desc" /> : desc}
          </div>
        )
      }
    </div>

    <!-- * Non-collapsible horizontal layout only — sits at the row's right edge, e.g. a chevron for clickable rows. -->
    {
      !collapsible && layout === "horizontal" && hasTrailing && (
        <div class="shrink-0 sm:ml-auto sm:self-center">
          <slot name="trailing" />
        </div>
      )
    }

    <!-- * Collapsible chevron — rotates 180° when open via the group-open Tailwind variant on the details element above. -->
    {
      collapsible && (
        <Icon
          name="line-md:chevron-down"
          width="16"
          height="16"
          aria-hidden="true"
          class="ml-auto shrink-0 text-(--color-text-muted) transition-transform duration-200 group-open:rotate-180"
        />
      )
    }
  </HeaderTag>

  <!-- Default slot for fully custom card content -->
  <slot />

  <!-- * Vertical layout (and collapsible, which always stacks its body) keeps trailing content at the bottom of the card. -->
  {(collapsible || layout === "vertical") && hasTrailing && <slot name="trailing" />}
</RootTag>
