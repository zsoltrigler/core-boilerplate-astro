---
export interface Props {
  /** Tooltip text to display on hover / focus. */
  tip: string
  placement?: "top" | "bottom" | "left" | "right"
  /** Wrap long text over several lines (max 16rem wide) instead of a single line. */
  multiline?: boolean
  /** Id of the tooltip bubble — auto-generated when omitted. The trigger's `aria-describedby` points at it. */
  id?: string
  class?: string
}

const {
  tip,
  placement = "top",
  multiline = false,
  id = `tooltip-${crypto.randomUUID().slice(0, 8)}`,
  class: className = "",
} = Astro.props

// * The bubble sits 0.5rem off the trigger via calc() (no margin); the `before:` bridge fills that
// * gap so the pointer can travel onto the bubble without losing :hover (WCAG 1.4.13 hoverable).
const positions: Record<string, string> = {
  top: "bottom-[calc(100%+0.5rem)] left-1/2 -translate-x-1/2 before:inset-x-0 before:top-full before:h-2",
  bottom:
    "top-[calc(100%+0.5rem)] left-1/2 -translate-x-1/2 before:inset-x-0 before:bottom-full before:h-2",
  left: "right-[calc(100%+0.5rem)] top-1/2 -translate-y-1/2 before:inset-y-0 before:left-full before:w-2",
  right:
    "left-[calc(100%+0.5rem)] top-1/2 -translate-y-1/2 before:inset-y-0 before:right-full before:w-2",
}
---

{
  /*
   * CSS-driven tooltip; a tiny script adds Escape-to-dismiss and the aria link.
   * Shows on hover and on keyboard focus-within. The wrapping span is inline-flex so it doesn't break text flow.
   *
   * ! Uses a NAMED group (group/tooltip) so it never reacts to an ancestor's own `group` (e.g. a clickable card).
   * ! The trigger must be focusable (e.g. <button type="button">) — that's what makes the tooltip
   *   reachable by keyboard and by tap on touch screens. The script sets aria-describedby on the
   *   first focusable element in the slot (WCAG 1.3.1 / 4.1.2), unless it already has one.
   */
}
<span data-tooltip class={`group/tooltip relative inline-flex ${className}`}>
  <slot />
  <span
    {id}
    role="tooltip"
    class={`pointer-events-none absolute before:absolute before:content-[''] ${positions[placement]} z-50 ${multiline ? "w-max max-w-64 whitespace-normal text-left" : "whitespace-nowrap"} rounded-md border border-(--color-border-base) bg-(--color-bg-elevated) px-2.5 py-1.5 text-xs font-medium text-(--color-text-base) shadow-sm opacity-0 transition-opacity duration-150 group-hover/tooltip:pointer-events-auto group-hover/tooltip:opacity-100 group-focus-within/tooltip:pointer-events-auto group-focus-within/tooltip:opacity-100 group-data-dismissed/tooltip:pointer-events-none! group-data-dismissed/tooltip:opacity-0!`}
  >
    {tip}
  </span>
</span>

<script>
  function initTooltips() {
    document.querySelectorAll<HTMLElement>("[data-tooltip]").forEach((wrapper) => {
      const bubble = wrapper.querySelector<HTMLElement>("[role='tooltip']")
      const trigger = wrapper.querySelector<HTMLElement>(
        "button, a[href], input, select, textarea, [tabindex]:not([tabindex='-1'])"
      )
      if (bubble?.id && trigger && !trigger.hasAttribute("aria-describedby")) {
        trigger.setAttribute("aria-describedby", bubble.id)
      }

      // * Escape hides the bubble until the pointer/focus leaves and comes back (WCAG 1.4.13 dismissible).
      const reset = () => wrapper.removeAttribute("data-dismissed")
      ;["mouseenter", "mouseleave", "focusin", "focusout"].forEach((type) =>
        wrapper.addEventListener(type, reset)
      )
    })

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return
      document.querySelectorAll<HTMLElement>("[data-tooltip]").forEach((wrapper) => {
        if (wrapper.matches(":hover, :focus-within")) wrapper.setAttribute("data-dismissed", "")
      })
    })
  }

  initTooltips()
</script>
