---
import type { HTMLAttributes } from "astro/types"
import IconButton from "./IconButton.astro"
import { Icon } from "astro-icon/components"

// * Extra attributes (id, data-*, aria-*, hidden, etc.) are forwarded to the root <dialog> via ...rest.
// ! Spread before the data-* hooks the component's script relies on.
export interface Props extends HTMLAttributes<"dialog"> {
  /** Unique id — used to wire the trigger button to this modal via data-modal-open. */
  id: string
  /** Modal heading shown in the header bar. */
  title?: string
  size?: "sm" | "md" | "lg" | "xl"
  /** aria-label for the × close button — override for a non-English site. */
  closeLabel?: string
  /** Open the modal as soon as the page loads — e.g. after a POST → redirect the server decides it should show. */
  openOnLoad?: boolean
  class?: string
}

const {
  id,
  title,
  size = "md",
  closeLabel = "Close modal",
  openOnLoad = false,
  class: className = "",
  ...rest
} = Astro.props

const sizes: Record<string, string> = {
  sm: "max-w-sm",
  md: "max-w-lg",
  lg: "max-w-2xl",
  xl: "max-w-4xl",
}
---

{
  /*
  * Native <dialog> element — provides built-in accessibility (role, aria-modal,
    focus trap) without JavaScript polyfills. Open via showModal(), close via close().
  * Other ways to open it (all share one openModal() in the script below):
  *   - openOnLoad prop → opens on page load.
  *   - document.dispatchEvent(new CustomEvent("modal:open", { detail: { id } }));
  *     "modal:close" closes it the same way.
*/
}
<dialog
  {...rest}
  id={id}
  data-modal
  data-open-on-load={openOnLoad ? "" : undefined}
  class={`w-full rounded-2xl border border-(--color-border-base) bg-(--color-bg-base) p-0 shadow-2xl mx-auto my-auto max-h-[90dvh] backdrop:bg-(--color-overlay)/60 backdrop:backdrop-blur-sm open:flex open:flex-col ${sizes[size]} ${className}`}
>
  {
    /* * Inner wrapper handles flex layout and overflow clipping separately from
       the dialog element — overflow-hidden on <dialog> would prevent body scroll. */
  }
  <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-2xl">
    {
      (title || Astro.slots.has("title")) && (
        <div class="flex shrink-0 items-center justify-between border-b border-(--color-border-base) px-6 py-4">
          <h2 class="text-lg font-semibold text-(--color-text-base)">
            {Astro.slots.has("title") ? <slot name="title" /> : title}
          </h2>

          <IconButton data-modal-close label={closeLabel} variant="ghost" size="sm">
            <Icon is:inline name="line-md:close" width="16" height="16" aria-hidden="true" />
          </IconButton>
        </div>
      )
    }

    <div class="flex-1 overflow-y-auto px-6 py-5 text-(--color-text-base)">
      <slot />
    </div>

    {
      Astro.slots.has("footer") && (
        <div class="flex shrink-0 items-center justify-end gap-3 border-t border-(--color-border-base) px-6 py-4">
          <slot name="footer" />
        </div>
      )
    }
  </div>
</dialog>

<script>
  // * Single open path — the trigger click, openOnLoad and the modal:open event all call this.
  function openModal(id: string) {
    const modal = document.getElementById(id) as HTMLDialogElement | null
    if (!modal || !modal.matches("[data-modal]") || modal.open) return

    modal.showModal()
    // ! showModal() does not lock body scroll by default — the page
    //   behind stays scrollable via wheel/touch unless done manually.
    document.documentElement.classList.add("overflow-hidden")
  }

  function closeModal(id: string) {
    const modal = document.getElementById(id) as HTMLDialogElement | null
    if (modal?.matches("[data-modal]")) modal.close()
  }

  document.querySelectorAll<HTMLElement>("[data-modal-open]").forEach((trigger) => {
    trigger.addEventListener("click", () => openModal(trigger.dataset.modalOpen!))
  })

  document.querySelectorAll<HTMLDialogElement>("[data-modal]").forEach((modal) => {
    modal.querySelectorAll("[data-modal-close]").forEach((btn) => {
      btn.addEventListener("click", () => modal.close())
    })

    // ! Backdrop click — <dialog> fills the viewport when open; clicks outside
    //   the inner panel land on the <dialog> element itself, not its children.
    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.close()
    })

    // ESC is handled natively by the browser for <dialog> — no extra code needed.

    // * The native "close" event fires however the dialog closes (the × button,
    //   backdrop click, or the browser's own ESC handling) — the safest single
    //   place to unlock scroll.
    modal.addEventListener("close", () => {
      document.documentElement.classList.remove("overflow-hidden")
    })

    if (modal.hasAttribute("data-open-on-load")) openModal(modal.id)
  })

  // * Programmatic API: document.dispatchEvent(new CustomEvent("modal:open", { detail: { id } }))
  document.addEventListener("modal:open", (e) =>
    openModal((e as CustomEvent<{ id: string }>).detail.id)
  )
  document.addEventListener("modal:close", (e) =>
    closeModal((e as CustomEvent<{ id: string }>).detail.id)
  )
</script>
