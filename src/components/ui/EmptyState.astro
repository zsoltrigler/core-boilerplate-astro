---
import type { HTMLAttributes } from "astro/types"
import { Icon } from "astro-icon/components"

// * Extra attributes (id, data-*, aria-*, hidden, etc.) are forwarded to the root <div> via ...rest.
export interface Props extends HTMLAttributes<"div"> {
  /** line-md icon name without the "line-md:" prefix. */
  icon: string
  title: string
  description?: string
  class?: string
}

const { icon, title, description, class: className = "", ...rest } = Astro.props
---

<div class={`flex flex-col items-center gap-2 px-5 py-10 text-center ${className}`} {...rest}>
  <span
    class="flex h-11 w-11 items-center justify-center rounded-full bg-(--color-bg-elevated) text-(--color-text-muted)"
  >
    <Icon is:inline name={`line-md:${icon}`} width="20" height="20" aria-hidden="true" />
  </span>
  <p class="text-sm font-semibold text-(--color-text-base)">{title}</p>
  {description && <p class="max-w-sm text-xs text-(--color-text-muted)">{description}</p>}
</div>
