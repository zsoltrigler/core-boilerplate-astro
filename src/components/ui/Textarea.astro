---
import type { HTMLAttributes } from "astro/types"
import { ariaDescribedBy } from "../../utils/aria"
import { fieldStateClasses } from "../../utils/fieldStyles"
import FormField from "./FormField.astro"

// * HTMLAttributes<"div"> is used purely for its attribute set — see Input.astro
//   for why it is deliberately not the native <textarea> set (`size` collides with the
//   size union below). Extra attributes (id, data-*, aria-*, etc.) are forwarded
//   to the underlying <textarea> via ...rest.
export interface Props extends HTMLAttributes<"div"> {
  name: string
  id?: string
  /** Visible label rendered above the textarea. */
  label?: string
  placeholder?: string
  value?: string
  /** Number of visible text rows. */
  rows?: number
  /** Maximum number of characters — the browser blocks typing past it. */
  maxlength?: number
  /** Minimum number of characters — checked by native constraint validation on submit. */
  minlength?: number
  /** Shows a live character counter in the hint row ("12 / 2000" with `maxlength`, "12" without). */
  showCount?: boolean
  /** Hint text displayed below the textarea. */
  hint?: string
  /** Error message — switches the textarea to error state when set. */
  error?: string
  disabled?: boolean
  required?: boolean
  fullWidth?: boolean
  class?: string
}

const {
  name,
  id,
  label,
  placeholder,
  value,
  rows = 4,
  maxlength,
  minlength,
  showCount = false,
  hint,
  error,
  disabled = false,
  required = false,
  fullWidth = false,
  class: className = "",
  ...rest
} = Astro.props

// * id falls back to name so label[for] always resolves even when id is omitted.
const textareaId = id ?? name

const base = [
  "w-full rounded-lg border bg-(--color-bg-base) px-4 py-2.5 text-base text-(--color-text-base) placeholder:text-(--color-text-muted)/60",
  "resize-y",
  fieldStateClasses(error),
].join(" ")
---

<FormField
  id={textareaId}
  label={label}
  required={required}
  error={error}
  hint={hint}
  count={showCount ? { current: (value ?? "").length, max: maxlength } : undefined}
  fullWidth={fullWidth}
  class={className}
>
  <textarea
    id={textareaId}
    name={name}
    rows={rows}
    placeholder={placeholder}
    maxlength={maxlength}
    minlength={minlength}
    disabled={disabled}
    required={required}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={ariaDescribedBy(textareaId, { error, hint })}
    class={base}
    {...rest}
  >{value}</textarea>
</FormField>
